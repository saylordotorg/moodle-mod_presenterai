{{!
    @template mod_presenterai/view

    The learner's page for one activity, in reading order: topics, the policy
    callout, the privacy paragraph, the recorder (or why it is not offered),
    the attempt list, a container the player opens into, and a polite live
    region that exists at page load so later announcements are spoken.

    The callout and the attempt list sit outside the recorder branch on
    purpose: a learner whose site has storage unconfigured, or who has used
    every attempt, is still told the policy and still sees their attempts.

    The recorder settings are data attributes on the root, read by
    mod_presenterai/view, rather than js_call_amd arguments.

    Context variables required for this template:
    * cmid - The course module id.
    * topics - Context for mod_presenterai/topics.
    * callout - Context for mod_presenterai/policy_callout.
    * privacy - The privacy paragraph, HTML.
    * canrecord - Whether the user may record at all.
    * showsubmissions - Whether to show the link to the submissions report.
    * submissionsurl - The submissions report URL.
    * blocked - Why recording is not offered right now, or empty.
    * recorder - Context for mod_presenterai/recorder, or null.
    * config - Recorder settings for the data attributes, or null.
    * attempts - Context for mod_presenterai/attempts.

    Example context (json):
    {
        "cmid": 12,
        "topics": {
            "hastopics": true,
            "topicselect": true,
            "singletopicid": 0,
            "topics": [
                {"id": 3, "title": "Renewable energy", "instructions": "<p>Argue for or against.</p>",
                    "hasinstructions": true, "files": [], "hasfiles": false},
                {"id": 4, "title": "City transport", "instructions": "", "hasinstructions": false,
                    "files": [{"filename": "brief.pdf", "url": "https://example.com/brief.pdf"}], "hasfiles": true}
            ]
        },
        "callout": {
            "variant": "keep_dl",
            "heading": "Your recording is kept until it is deleted.",
            "body": "Nothing deletes this recording automatically.",
            "prunewarning": ""
        },
        "privacy": "Your recording is uploaded to Example storage so it can be transcribed and scored.",
        "canrecord": true,
        "showsubmissions": true,
        "submissionsurl": "https://example.com/mod/presenterai/report.php?id=12",
        "blocked": "",
        "recorder": {
            "isaudio": false,
            "isvideo": true,
            "slides": true,
            "limits": "Record for between 5:00 and 7:00.",
            "visualdisclosure": true,
            "visualoptout": false
        },
        "config": {
            "mode": "video",
            "minseconds": 300,
            "maxseconds": 420,
            "width": 854,
            "height": 480,
            "videokbps": 500,
            "audiokbps": 40,
            "slides": 1,
            "maxbytes": 157286400,
            "videovision": 1,
            "allowvisualoptout": 0,
            "warmstt": 0,
            "audiotrack": 1,
            "audiotrackkbps": 32
        },
        "attempts": {
            "hasattempts": true,
            "showdownloadoffnote": false,
            "rows": [
                {
                    "recid": 7,
                    "attempt": "1",
                    "recorded": "6/10/26, 14:00",
                    "length": "6:12",
                    "status": "Submitted",
                    "statekey": "attempt_kept",
                    "state": "Kept until deleted",
                    "mediaavailable": true,
                    "canwatch": true,
                    "watcharia": "Watch the recording you made on 6/10/26, 14:00",
                    "candownload": true,
                    "downloadurl": "https://example.com/mod/presenterai/download.php?id=7",
                    "downloadaria": "Download the recording you made on 6/10/26, 14:00",
                    "candelete": true,
                    "deletearia": "Delete the recording you made on 6/10/26, 14:00",
                    "gonenote": "",
                    "hasscore": true,
                    "score": "80.00%",
                    "hasfeedback": true,
                    "feedbackaria": "Feedback on the attempt you made on 6/10/26, 14:00",
                    "feedback": {
                        "criteria": [
                            {"name": "Content", "scoretext": "4 out of 5", "feedback": "Clear thesis."}
                        ],
                        "overall": "A well organized talk."
                    }
                }
            ]
        }
    }
}}
<div id="mod-presenterai-view" class="mod-presenterai-view" data-cmid="{{cmid}}" {{#config}}data-mode="{{mode}}" data-minseconds="{{minseconds}}" data-maxseconds="{{maxseconds}}" data-width="{{width}}" data-height="{{height}}" data-videokbps="{{videokbps}}" data-audiokbps="{{audiokbps}}" data-slides="{{slides}}" data-maxbytes="{{maxbytes}}" data-videovision="{{videovision}}" data-allowvisualoptout="{{allowvisualoptout}}" data-warmstt="{{warmstt}}" data-audiotrack="{{audiotrack}}" data-audiotrackkbps="{{audiotrackkbps}}"{{/config}} {{#topics}}data-topicid="{{singletopicid}}"{{/topics}}>
    {{#topics}}
    {{> mod_presenterai/topics }}
    {{/topics}}
    {{#callout}}
    {{> mod_presenterai/policy_callout }}
    {{/callout}}
    <p class="mod-presenterai-privacy small">{{{privacy}}}</p>
    {{#canrecord}}
    {{#blocked}}
    <div class="mod-presenterai-blocked alert alert-info">{{blocked}}</div>
    {{/blocked}}
    {{#recorder}}
    {{> mod_presenterai/recorder }}
    {{/recorder}}
    {{/canrecord}}
    {{#showsubmissions}}
    <p class="mod-presenterai-submissions-link mt-4"><a href="{{submissionsurl}}">{{#str}}viewsubmissions, mod_presenterai{{/str}}</a></p>
    {{/showsubmissions}}
    {{#attempts}}
    {{> mod_presenterai/attempts }}
    {{/attempts}}
    <div class="mod-presenterai-player mt-3" data-region="player" tabindex="-1"></div>
    <div class="accesshide" aria-live="polite" data-region="live"></div>
</div>

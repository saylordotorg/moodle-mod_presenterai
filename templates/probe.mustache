{{!
    @template mod_presenterai/probe

    The storage check page: each backend's self test as a table, the count of
    recordings with media per backend, and the upload chunk ladder.

    Every result carries a word as well as a colour, so the page reads the
    same to someone who cannot tell the badges apart. The results of the
    ladder are announced through a polite live region that exists when the
    page loads, because a region added later is not reliably announced.

    Classes required for JS:
    * none

    Data attributes required for JS:
    * data-region="mod_presenterai-probe" with data-url and data-rungs
    * data-action="measure"
    * data-region="probe-results"

    Context variables required for this template:
    * arms - list of {name, label, configured, steps: [{step, label, ok, detail}]}
    * hascounts - whether any recording has media
    * counts - list of {text}, one line per backend
    * hassaved - whether a chunk size has been saved
    * chunksaved - the saved chunk size, formatted
    * probeurl - URL of probe.php
    * rungs - JSON list of {bytes, label}

    Example context (json):
    {
        "arms": [
            {
                "name": "fs",
                "label": "Moodle file storage",
                "configured": true,
                "steps": [
                    {"step": "staging", "label": "Staging directory", "ok": true, "detail": "Wrote and read back a staging file."},
                    {"step": "byteserving", "label": "Seeking", "ok": false, "detail": "Byte serving is off."}
                ]
            }
        ],
        "hascounts": true,
        "counts": [{"text": "Moodle file storage: 12 recordings"}],
        "hassaved": true,
        "chunksaved": "1 MB",
        "probeurl": "https://example.org/mod/presenterai/probe.php",
        "rungs": "[{\"bytes\":524288,\"label\":\"512 KB\"}]"
    }
}}
<div data-region="mod_presenterai-probe" data-url="{{probeurl}}" data-rungs="{{rungs}}">
    <p>{{#str}} probe_intro, mod_presenterai {{/str}}</p>

    {{#arms}}
    <h3>{{label}}</h3>
    {{^configured}}
    <p class="alert alert-warning">{{#str}} probe_notconfigured, mod_presenterai {{/str}}</p>
    {{/configured}}
    <table class="generaltable">
        <caption class="accesshide">{{#str}} probe_tablecaption, mod_presenterai, {{label}} {{/str}}</caption>
        <thead>
            <tr>
                <th scope="col">{{#str}} probe_col_step, mod_presenterai {{/str}}</th>
                <th scope="col">{{#str}} probe_col_result, mod_presenterai {{/str}}</th>
                <th scope="col">{{#str}} probe_col_detail, mod_presenterai {{/str}}</th>
            </tr>
        </thead>
        <tbody>
            {{#steps}}
            <tr>
                <th scope="row">{{label}}</th>
                <td>
                    {{#ok}}<span class="badge bg-success text-white">{{#str}} probe_ok, mod_presenterai {{/str}}</span>{{/ok}}
                    {{^ok}}<span class="badge bg-danger text-white">{{#str}} probe_fail, mod_presenterai {{/str}}</span>{{/ok}}
                </td>
                <td>{{detail}}</td>
            </tr>
            {{/steps}}
        </tbody>
    </table>
    {{/arms}}

    <h3>{{#str}} probe_countsheading, mod_presenterai {{/str}}</h3>
    {{#hascounts}}
    <ul>
        {{#counts}}
        <li>{{text}}</li>
        {{/counts}}
    </ul>
    {{/hascounts}}
    {{^hascounts}}
    <p>{{#str}} probe_countsnone, mod_presenterai {{/str}}</p>
    {{/hascounts}}

    <h3>{{#str}} probe_chunkheading, mod_presenterai {{/str}}</h3>
    <p>{{#str}} probe_chunkexplain, mod_presenterai {{/str}}</p>
    {{#hassaved}}
    <p>{{#str}} probe_chunksaved, mod_presenterai, {{chunksaved}} {{/str}}</p>
    {{/hassaved}}
    {{^hassaved}}
    <p>{{#str}} probe_chunknone, mod_presenterai {{/str}}</p>
    {{/hassaved}}
    <button type="button" class="btn btn-secondary" data-action="measure">{{#str}} probe_measure, mod_presenterai {{/str}}</button>
    <div class="mt-3" aria-live="polite" data-region="probe-results"></div>
</div>

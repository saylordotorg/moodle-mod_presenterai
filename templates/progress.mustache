{{!
    @template mod_presenterai/progress

    The learner's progress across their scored attempts (0.8.0), shown on the
    learner page when they have two or more attempts with a visible score.
    A sentence says where they started and where they are now, and a table
    lists each scored attempt, oldest first, with its score and the change
    since the attempt before it, in words, so no chart is needed and a screen
    reader reads it like any other table.

    Every value comes from view_page::progress().

    Context variables required for this template:
    * summary - One sentence, first score to latest score.
    * rows - List of attempt, score, change (words) and direction (first, up, down or same).

    Example context (json):
    {
        "hasprogress": true,
        "summary": "Your score went from 60.00% on attempt 1 to 75.00% on attempt 3.",
        "rows": [
            {"attempt": "1", "score": "60.00%", "change": "First scored attempt", "direction": "first"},
            {"attempt": "2", "score": "70.00%", "change": "Up 10 percentage points", "direction": "up"},
            {"attempt": "3", "score": "75.00%", "change": "Up 5 percentage points", "direction": "up"}
        ]
    }
}}
<section class="mod-presenterai-progress mt-3" data-region="progress" aria-labelledby="mod-presenterai-progress-{{uniqid}}">
    <h3 class="h5" id="mod-presenterai-progress-{{uniqid}}">{{#str}}progress_heading, mod_presenterai{{/str}}</h3>
    <p class="mod-presenterai-progress-summary">{{summary}}</p>
    <table class="generaltable mod-presenterai-progress-table">
        <caption class="accesshide">{{#str}}progress_caption, mod_presenterai{{/str}}</caption>
        <thead>
            <tr>
                <th scope="col">{{#str}}col_attempt, mod_presenterai{{/str}}</th>
                <th scope="col">{{#str}}col_score, mod_presenterai{{/str}}</th>
                <th scope="col">{{#str}}progress_change, mod_presenterai{{/str}}</th>
            </tr>
        </thead>
        <tbody>
            {{#rows}}
            <tr data-direction="{{direction}}">
                <th scope="row">{{attempt}}</th>
                <td>{{score}}</td>
                <td>{{change}}</td>
            </tr>
            {{/rows}}
        </tbody>
    </table>
</section>
